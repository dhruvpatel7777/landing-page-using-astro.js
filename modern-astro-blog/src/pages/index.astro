---
// index.astro
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import LogoCloud from '../components/LogoCloud.astro';
import BentoGrid from '../components/BentoGrid.astro';
import FeatureTabs from '../components/FeatureTabs.astro';
import WorkflowSteps from '../components/WorkflowSteps.astro';
import RoiCalculator from '../components/RoiCalculator.astro';
import Testimonials from '../components/Testimonials.astro';
import Pricing from '../components/Pricing.astro';
import Faq from '../components/Faq.astro';
import CtaBanner from '../components/CtaBanner.astro';
---

<Layout
  title="PulseAI — The Autonomous Intelligence Layer for High-Velocity Engineering"
  description="Automate complex code refactoring, pinpoint sub-millisecond trace anomalies, and deploy mission-critical systems with mathematical confidence."
>
  <!-- Hero Section with Cockpit Showcase -->
  <Hero />

  <!-- Trusted Tech Leaders Logos -->
  <LogoCloud />

  <!-- Bento Grid Architectural Highlights -->
  <BentoGrid />

  <!-- Deep Interactive Feature Tabs -->
  <FeatureTabs />

  <!-- 3-Step Production Workflow -->
  <WorkflowSteps />

  <!-- Interactive ROI & Savings Calculator -->
  <RoiCalculator />

  <!-- Verified Customer Testimonials & Reviews -->
  <Testimonials />

  <!-- Predictable Pricing Matrix with Annual/Monthly Toggle -->
  <Pricing />

  <!-- Interactive FAQ Accordion -->
  <Faq />

  <!-- Bottom Conversion Call-to-Action Card -->
  <CtaBanner />
</Layout>
