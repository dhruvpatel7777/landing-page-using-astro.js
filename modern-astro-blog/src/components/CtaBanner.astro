---
// CtaBanner.astro
---

<section class="section cta-section">
  <div class="container">
    <div class="glass-card cta-card">
      <div class="cta-glow"></div>

      <div class="cta-content">
        <span class="section-tag cta-tag">ACCELERATE YOUR TEAM TODAY</span>
        <h2 class="cta-title">
          Ready to eliminate engineering bottlenecks forever?
        </h2>
        <p class="cta-desc">
          Join over 45,000 developers building, optimizing, and deploying mission-critical systems with mathematical confidence.
        </p>

        <!-- Interactive Email Form -->
        <form class="cta-form" id="cta-form" onsubmit="return false;">
          <div class="input-wrapper">
            <svg class="mail-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            <input
              type="email"
              id="cta-email"
              class="cta-input"
              placeholder="Enter your work email address..."
              required
            />
          </div>
          <button type="submit" id="cta-submit-btn" class="btn btn-primary btn-lg cta-btn">
            <span>Start Free 14-Day Trial</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </button>
        </form>

        <div id="cta-success-msg" class="cta-success">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span>Welcome aboard! Check your inbox for instant access credentials.</span>
        </div>

        <div class="cta-reassurances">
          <span class="reassurance-item">
            <svg class="check-sm" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            No credit card required
          </span>
          <span class="reassurance-item">
            <svg class="check-sm" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            14-day free trial on Pro
          </span>
          <span class="reassurance-item">
            <svg class="check-sm" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            SOC2 Type II & GDPR Ready
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding-top: 4rem;
    padding-bottom: 6rem;
  }

  .cta-card {
    position: relative;
    padding: 5rem 3rem;
    text-align: center;
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, rgba(99, 102, 241, 0.12) 0%, rgba(15, 22, 41, 0.95) 100%);
    border: 1px solid rgba(99, 102, 241, 0.3);
    box-shadow: 0 20px 60px -15px rgba(0, 0, 0, 0.7), 0 0 40px rgba(99, 102, 241, 0.2);
    overflow: hidden;
  }

  [data-theme="light"] .cta-card {
    background: linear-gradient(180deg, rgba(99, 102, 241, 0.08) 0%, rgba(255, 255, 255, 0.95) 100%);
    border-color: rgba(99, 102, 241, 0.25);
  }

  @media (max-width: 768px) {
    .cta-card {
      padding: 3rem 1.5rem;
    }
  }

  .cta-glow {
    position: absolute;
    top: -50%;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 350px;
    background: radial-gradient(circle, rgba(99, 102, 241, 0.35) 0%, rgba(6, 182, 212, 0.2) 50%, transparent 80%);
    filter: blur(60px);
    pointer-events: none;
  }

  .cta-content {
    position: relative;
    z-index: 1;
    max-width: 780px;
    margin: 0 auto;
  }

  .cta-title {
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    font-weight: 850;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--text-highlight);
    margin-bottom: 1.25rem;
  }

  .cta-desc {
    font-size: clamp(1rem, 1.3vw, 1.2rem);
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 2.75rem;
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
  }

  .cta-form {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    max-width: 580px;
    margin: 0 auto 1.5rem auto;
    flex-wrap: wrap;
  }

  .input-wrapper {
    flex: 1;
    min-width: 260px;
    position: relative;
    display: flex;
    align-items: center;
  }

  .mail-icon {
    position: absolute;
    left: 1rem;
    color: var(--text-muted);
    pointer-events: none;
  }

  .cta-input {
    width: 100%;
    padding: 0.9rem 1rem 0.9rem 2.85rem;
    border-radius: var(--radius-md);
    background: var(--bg-primary);
    border: 1px solid var(--border-medium);
    color: var(--text-primary);
    font-size: 0.95rem;
    outline: none;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .cta-input:focus {
    border-color: var(--brand-primary);
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.25);
  }

  .cta-btn {
    padding: 0.9rem 1.6rem;
  }

  .cta-success {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.85rem 1.25rem;
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-radius: var(--radius-md);
    color: #10b981;
    font-weight: 600;
    font-size: 0.92rem;
    margin: 0 auto 1.5rem auto;
    max-width: 580px;
  }

  .cta-success.visible {
    display: flex;
  }

  .cta-reassurances {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    font-size: 0.84rem;
    color: var(--text-muted);
  }

  .reassurance-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .check-sm {
    width: 16px;
    height: 16px;
    color: var(--brand-emerald);
  }
</style>

<script is:inline>
  const ctaForm = document.getElementById('cta-form');
  const ctaEmail = document.getElementById('cta-email');
  const ctaSuccess = document.getElementById('cta-success-msg');

  ctaForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (ctaEmail && ctaEmail.value && ctaEmail.checkValidity()) {
      ctaForm.style.display = 'none';
      ctaSuccess?.classList.add('visible');
    }
  });
</script>

