---
// DemoModal.astro
---

<div id="demo-modal" class="modal-backdrop" aria-hidden="true" role="dialog" aria-modal="true">
  <div class="glass-card modal-content">
    <div class="modal-header">
      <div class="modal-title-wrap">
        <span class="modal-tag">PULSE IN ACTION</span>
        <h3 class="modal-title">Live 2-Minute Product Walkthrough</h3>
      </div>
      <button type="button" id="close-modal-btn" class="modal-close" aria-label="Close dialog">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>

    <!-- Video / Interactive Demo Mockup Screen -->
    <div class="demo-screen">
      <div class="demo-screen-inner">
        <div class="play-indicator-overlay">
          <div class="big-play-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="currentColor"><polygon points="6 3 20 12 6 21 6 3"/></svg>
          </div>
          <div class="play-label">Simulating Autonomous Refactoring on a 1.2M Line Repo</div>
        </div>

        <!-- Simulated code visual behind overlay -->
        <div class="sim-code-bg">
          <pre><code>
// Automated synthesis in progress...
[10:42:15] Synthesizing AST diff for microservices/checkout...
[10:42:16] Identified redundant SQL N+1 query loop in orders_resolver.go:88
[10:42:17] Replacing with batch DataLoader pattern...
[10:42:18] Running 48 concurrency integration tests... 100% Passed.
[10:42:19] PR #412 automatically created and labeled ready-for-review.
          </code></pre>
        </div>
      </div>
    </div>

    <div class="modal-footer">
      <div class="modal-perks">
        <span>✓ Zero configuration required</span>
        <span>✓ Works with your existing stack</span>
      </div>
      <div class="modal-actions">
        <a href="#pricing" class="btn btn-primary" id="modal-cta-btn">Start Free Trial Now</a>
      </div>
    </div>
  </div>
</div>

<style>
  .modal-backdrop {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(4, 7, 13, 0.82);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    z-index: 200;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    transition: opacity var(--transition-base);
  }

  .modal-backdrop.open {
    display: flex;
    opacity: 1;
  }

  .modal-content {
    max-width: 780px;
    width: 100%;
    padding: 2rem;
    background: var(--bg-card);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    box-shadow: 0 25px 60px -10px rgba(0, 0, 0, 0.8), 0 0 40px rgba(99, 102, 241, 0.3);
    position: relative;
    transform: scale(0.95);
    transition: transform var(--transition-base);
  }

  .modal-backdrop.open .modal-content {
    transform: scale(1);
  }

  .modal-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .modal-tag {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--brand-accent);
    letter-spacing: 0.08em;
  }

  .modal-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--text-highlight);
    margin-top: 0.25rem;
  }

  .modal-close {
    color: var(--text-muted);
    padding: 0.5rem;
    border-radius: 50%;
    background: var(--bg-tertiary);
    cursor: pointer;
    transition: all var(--transition-fast);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .modal-close:hover {
    color: #fff;
    background: var(--brand-rose);
  }

  .demo-screen {
    border-radius: var(--radius-md);
    overflow: hidden;
    background: #090d16;
    border: 1px solid var(--border-subtle);
    margin-bottom: 1.5rem;
  }

  .demo-screen-inner {
    position: relative;
    padding: 2rem 1.5rem;
    min-height: 240px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .play-indicator-overlay {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    z-index: 2;
    text-align: center;
  }

  .big-play-btn {
    width: 68px;
    height: 68px;
    border-radius: 50%;
    background: var(--gradient-brand);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 30px rgba(99, 102, 241, 0.7);
    cursor: pointer;
    transition: transform var(--transition-fast);
  }

  .big-play-btn:hover {
    transform: scale(1.1);
  }

  .play-label {
    font-size: 0.95rem;
    font-weight: 600;
    color: #f8fafc;
  }

  .sim-code-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    opacity: 0.2;
    padding: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: #38bdf8;
    overflow: hidden;
    pointer-events: none;
  }

  .modal-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  .modal-perks {
    display: flex;
    gap: 1.25rem;
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  @media (max-width: 600px) {
    .modal-footer {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>

<script is:inline>
  const openBtn = document.getElementById('open-demo-btn');
  const modal = document.getElementById('demo-modal');
  const closeBtn = document.getElementById('close-modal-btn');
  const modalCta = document.getElementById('modal-cta-btn');

  function openModal() {
    modal?.classList.add('open');
    modal?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal?.classList.remove('open');
    modal?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  openBtn?.addEventListener('click', openModal);
  closeBtn?.addEventListener('click', closeModal);
  modalCta?.addEventListener('click', closeModal);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal?.classList.contains('open')) {
      closeModal();
    }
  });
</script>

