---
// Faq.astro
const faqs = [
  {
    q: "How does Pulse prevent AI hallucinations and buggy code merges?",
    a: "Unlike generic chat models, Pulse works at the Abstract Syntax Tree (AST) compiler level. Every change proposed by Pulse must pass your test suite, type-checking, and automated formal verification solvers before a pull request or canary deploy can be executed. If a test fails or compiler error arises, Pulse self-corrects or asks for human review."
  },
  {
    q: "Is our proprietary source code ever used to train AI models?",
    a: "Never. We enforce a strict Zero-Data-Retention policy. Your code is processed in volatile memory inside hardware-isolated enclaves (AMD SEV-SNP) and is completely erased the moment the pipeline completes. We never use client code for foundation model training or telemetry harvesting."
  },
  {
    q: "What languages, runtimes, and frameworks are supported?",
    a: "Pulse supports JavaScript/TypeScript (Node.js, Deno, Bun), Astro, Next.js, Python, Go, Rust, Java, and Dockerized microservices. Our AST engine includes first-class type checkers for TypeScript, Rust (rustc/clippy), Python (mypy/pyright), and Go."
  },
  {
    q: "How long does initial setup and onboarding take?",
    a: "Most teams are fully up and running in under 5 minutes. You simply link your GitHub or GitLab organization, select the target repositories, and set your policy guardrails. Pulse immediately analyzes your dependencies without requiring code changes."
  },
  {
    q: "Can we deploy Pulse on-premise or within our own private VPC?",
    a: "Yes. Our Enterprise tier includes full VPC self-hosting options for AWS GovCloud, GCP, Microsoft Azure, or bare-metal Kubernetes clusters, complete with air-gapped license provisioning and SOC2 compliance artifacts."
  },
  {
    q: "What happens when our 14-day Pro trial ends?",
    a: "You won't be charged unless you choose to enter billing details. If you decide not to upgrade, your account automatically reverts to the generous Developer tier, and all your existing configurations remain intact."
  }
];
---

<section class="section" id="faq">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">QUESTIONS & ANSWERS</span>
      <h2 class="section-title">Frequently asked questions</h2>
      <p class="section-desc">
        Everything you need to know about Pulse's architecture, security, and pricing.
      </p>
    </div>

    <div class="faq-accordion-wrapper">
      {faqs.map((faq, idx) => (
        <div class="glass-card faq-item" data-index={idx}>
          <button class="faq-question" type="button" aria-expanded="false" aria-controls={`faq-answer-${idx}`}>
            <span class="q-text">{faq.q}</span>
            <span class="q-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
            </span>
          </button>
          <div class="faq-answer" id={`faq-answer-${idx}`} aria-hidden="true">
            <p>{faq.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-accordion-wrapper {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .faq-item {
    border-radius: var(--radius-md);
    transition: border-color var(--transition-fast);
  }

  .faq-item.open {
    border-color: var(--brand-primary);
  }

  .faq-question {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.4rem 1.75rem;
    text-align: left;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-highlight);
    background: none;
    cursor: pointer;
  }

  .q-text {
    padding-right: 1.5rem;
  }

  .q-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--brand-primary);
    transition: transform var(--transition-base);
    flex-shrink: 0;
  }

  .faq-item.open .q-icon {
    transform: rotate(180deg);
  }

  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s cubic-bezier(0, 1, 0, 1), padding 0.3s ease;
    padding: 0 1.75rem;
  }

  .faq-item.open .faq-answer {
    max-height: 500px;
    transition: max-height 0.35s cubic-bezier(1, 0, 1, 0), padding 0.35s ease;
    padding: 0 1.75rem 1.5rem 1.75rem;
  }

  .faq-answer p {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }
</style>

<script is:inline>
  const faqItems = document.querySelectorAll('.faq-item');

  faqItems.forEach(item => {
    const btn = item.querySelector('.faq-question');
    const ans = item.querySelector('.faq-answer');

    btn?.addEventListener('click', () => {
      const isOpen = item.classList.contains('open');

      // Close all others
      faqItems.forEach(other => {
        if (other !== item) {
          other.classList.remove('open');
          other.querySelector('.faq-question')?.setAttribute('aria-expanded', 'false');
          other.querySelector('.faq-answer')?.setAttribute('aria-hidden', 'true');
        }
      });

      if (isOpen) {
        item.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
        ans?.setAttribute('aria-hidden', 'true');
      } else {
        item.classList.add('open');
        btn.setAttribute('aria-expanded', 'true');
        ans?.setAttribute('aria-hidden', 'false');
      }
    });
  });
</script>

