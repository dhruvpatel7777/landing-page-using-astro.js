---
// LogoCloud.astro
---

<section class="logocloud-section">
  <div class="container">
    <p class="logocloud-title">TRUSTED BY 45,000+ ENGINEERS AT INNOVATIVE COMPANIES WORLDWIDE</p>

    <div class="logos-grid">
      <!-- Vercel -->
      <div class="logo-item" title="Vercel">
        <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor">
          <path d="M12 1L24 22H0L12 1Z" />
        </svg>
        <span class="logo-text">Vercel</span>
      </div>

      <!-- GitHub -->
      <div class="logo-item" title="GitHub">
        <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor">
          <path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.1-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2Z"/>
        </svg>
        <span class="logo-text">GitHub</span>
      </div>

      <!-- Stripe -->
      <div class="logo-item" title="Stripe">
        <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor">
          <path d="M13.976 9.15c-2.172-.806-3.356-1.426-3.356-2.409 0-.831.683-1.305 1.901-1.305 2.227 0 4.515.858 6.09 1.631l.89-5.494C18.252.975 15.697.5 12.39.5 6.088.5 2.012 3.864 2.012 8.784c0 5.485 5.565 6.554 8.729 7.747 2.547.962 3.42 1.632 3.42 2.664 0 .973-.896 1.488-2.38 1.488-2.28 0-5.187-.998-6.958-2.02l-.916 5.626C5.58 25.132 8.728 25.5 11.83 25.5c6.544 0 10.749-3.235 10.749-8.47 0-5.32-5.186-6.495-8.603-7.88z"/>
        </svg>
        <span class="logo-text">Stripe</span>
      </div>

      <!-- Supabase -->
      <div class="logo-item" title="Supabase">
        <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor">
          <path d="M21.362 9.354H12V.396a.396.396 0 0 0-.716-.233L.68 14.153a.396.396 0 0 0 .318.638h9.362v8.813a.396.396 0 0 0 .716.233l10.604-13.845a.396.396 0 0 0-.318-.638z"/>
        </svg>
        <span class="logo-text">Supabase</span>
      </div>

      <!-- Cloudflare -->
      <div class="logo-item" title="Cloudflare">
        <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor">
          <path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96z"/>
        </svg>
        <span class="logo-text">Cloudflare</span>
      </div>

      <!-- Datadog -->
      <div class="logo-item" title="Datadog">
        <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor">
          <path d="M19.5 4.5A2.5 2.5 0 0 0 17 2H7A2.5 2.5 0 0 0 4.5 4.5v15A2.5 2.5 0 0 0 7 22h10a2.5 2.5 0 0 0 2.5-2.5v-15zM12 18a6 6 0 1 1 0-12 6 6 0 0 1 0 12z"/>
        </svg>
        <span class="logo-text">Datadog</span>
      </div>
    </div>
  </div>
</section>

<style>
  .logocloud-section {
    padding-top: 2rem;
    padding-bottom: 4rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .logocloud-title {
    text-align: center;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  .logos-grid {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3.5rem;
    flex-wrap: wrap;
  }

  .logo-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text-muted);
    opacity: 0.65;
    transition: opacity var(--transition-fast), color var(--transition-fast), transform var(--transition-fast);
  }

  .logo-item:hover {
    opacity: 1;
    color: var(--text-highlight);
    transform: translateY(-2px);
  }

  .logo-text {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  @media (max-width: 768px) {
    .logos-grid {
      gap: 2rem;
    }
  }
</style>

