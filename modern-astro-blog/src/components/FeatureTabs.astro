---
// FeatureTabs.astro
---

<section class="section" id="features">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">COMPREHENSIVE CAPABILITIES</span>
      <h2 class="section-title">Built for modern high-performance dev teams</h2>
      <p class="section-desc">
        Switch between Pulse's core operating modes to see how automated intelligence replaces hours of manual toil.
      </p>
    </div>

    <!-- Interactive Tabs Navigation -->
    <div class="tabs-nav" role="tablist">
      <button class="tab-btn active" data-tab="tab-intelligence" role="tab" aria-selected="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v4"/><path d="M12 18v4"/><path d="M4.93 4.93l2.83 2.83"/><path d="M16.24 16.24l2.83 2.83"/><path d="M2 12h4"/><path d="M18 12h4"/><path d="M4.93 19.07l2.83-2.83"/><path d="M16.24 7.76l2.83-2.83"/></svg>
        <span>Autonomous Intelligence</span>
      </button>

      <button class="tab-btn" data-tab="tab-deploy" role="tab" aria-selected="false">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/></svg>
        <span>Instant Global Rollouts</span>
      </button>

      <button class="tab-btn" data-tab="tab-observability" role="tab" aria-selected="false">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12h5l3 7 4-14 3 7h5"/></svg>
        <span>Realtime Telemetry</span>
      </button>

      <button class="tab-btn" data-tab="tab-security" role="tab" aria-selected="false">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        <span>Zero-Trust Enclaves</span>
      </button>
    </div>

    <!-- Tab Panels Container -->
    <div class="tabs-content">
      <!-- Tab 1: Intelligence -->
      <div id="tab-intelligence" class="tab-panel active glass-card" role="tabpanel">
        <div class="panel-info">
          <div class="panel-badge">REASONING ENGINE</div>
          <h3 class="panel-heading">Context-aware AST refactoring that acts like your principal engineer</h3>
          <p class="panel-text">
            Pulse builds a living semantic graph of your monorepo. When schema changes or deprecations land, Pulse analyzes every dependent service, automatically generating backwards-compatible updates with exhaustive test coverage.
          </p>
          <ul class="panel-features">
            <li>
              <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span>Understands complex multi-package dependencies & types</span>
            </li>
            <li>
              <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span>Automatically writes unit, integration, and fuzz test cases</span>
            </li>
            <li>
              <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span>Zero hallucinations: all output checked against compiler rules</span>
            </li>
          </ul>
        </div>
        <div class="panel-preview">
          <div class="interactive-card">
            <div class="card-bar">
              <span>AST Graph Visualizer</span>
              <span class="status-pill green">Validated 142 Nodes</span>
            </div>
            <div class="graph-nodes">
              <div class="node-box main-node">api-gateway</div>
              <div class="node-arrow">↳</div>
              <div class="node-box sub-node">auth-service (Optimized)</div>
              <div class="node-arrow">↳</div>
              <div class="node-box sub-node">postgres-replica pool</div>
            </div>
            <div class="code-box-preview">
              <code>// Generated fix: zero-allocation memory pool</code><br/>
              <code>export const bufferPool = new SafeArenaAllocator(1024 * 64);</code>
            </div>
          </div>
        </div>
      </div>

      <!-- Tab 2: Deploy -->
      <div id="tab-deploy" class="tab-panel glass-card" role="tabpanel">
        <div class="panel-info">
          <div class="panel-badge">GLOBAL RUNTIMES</div>
          <h3 class="panel-heading">Push to Git, go live across 310+ edge locations in 420 milliseconds</h3>
          <p class="panel-text">
            Pulse compiles your application code into ultra-optimized WebAssembly binaries and distributes them instantaneously with automatic canary traffic allocation and automated rollback if error rates exceed 0.001%.
          </p>
          <ul class="panel-features">
            <li>
              <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span>Autonomous blue/green and percentage-based canary routing</span>
            </li>
            <li>
              <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span>Zero cold starts with persistent warmed memory snapshots</span>
            </li>
            <li>
              <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span>Instantaneous 1-click rollback in less than 50ms</span>
            </li>
          </ul>
        </div>
        <div class="panel-preview">
          <div class="interactive-card">
            <div class="card-bar">
              <span>Canary Deployment Pipeline</span>
              <span class="status-pill green">Active 10% → 100%</span>
            </div>
            <div class="deploy-stage">
              <div class="stage-item completed">
                <span class="stage-num">✓</span>
                <span>Compile WASM</span>
              </div>
              <div class="stage-item completed">
                <span class="stage-num">✓</span>
                <span>Fuzz Testing</span>
              </div>
              <div class="stage-item active">
                <span class="stage-num">⚡</span>
                <span>Global Edge Mesh (18 regions)</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Tab 3: Observability -->
      <div id="tab-observability" class="tab-panel glass-card" role="tabpanel">
        <div class="panel-info">
          <div class="panel-badge">CONTINUOUS TELEMETRY</div>
          <h3 class="panel-heading">Pinpoint concurrency spikes and latency anomalies down to the line of code</h3>
          <p class="panel-text">
            No more digging through gigabytes of cryptic logs. Pulse's correlation engine automatically links HTTP 5xx responses, slow database queries, and high CPU usage directly to the exact Git commit and author.
          </p>
          <ul class="panel-features">
            <li>
              <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span>Microsecond-granularity trace waterfalls with zero overhead</span>
            </li>
            <li>
              <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span>Automated root-cause summary delivered directly to Slack & Discord</span>
            </li>
            <li>
              <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span>Native OpenTelemetry protocol support out of the box</span>
            </li>
          </ul>
        </div>
        <div class="panel-preview">
          <div class="interactive-card">
            <div class="card-bar">
              <span>Trace Root-Cause Engine</span>
              <span class="status-pill cyan">AI Correlated</span>
            </div>
            <div class="trace-row">
              <span class="trace-label">GET /api/v2/checkout</span>
              <span class="trace-duration text-emerald">28ms (p95)</span>
            </div>
            <div class="trace-row sub">
              <span class="trace-label">↳ db.query("SELECT * FROM orders")</span>
              <span class="trace-duration text-amber">19ms (Index suggested)</span>
            </div>
            <div class="trace-suggestion">
              💡 <strong>AI Recommendation:</strong> Add composite index on <code class="code-inline">(user_id, status)</code> to drop query to 1.2ms.
            </div>
          </div>
        </div>
      </div>

      <!-- Tab 4: Security -->
      <div id="tab-security" class="tab-panel glass-card" role="tabpanel">
        <div class="panel-info">
          <div class="panel-badge">CONFIDENTIAL COMPUTING</div>
          <h3 class="panel-heading">Encrypted enclaves guarantee your proprietary IP stays private</h3>
          <p class="panel-text">
            Pulse processes code inside hardware-encrypted AMD SEV-SNP enclaves. Your code is never written to disk unencrypted, never shared with third-party model providers, and vanishes from memory upon pipeline termination.
          </p>
          <ul class="panel-features">
            <li>
              <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span>Hardware-attested cryptographic cryptographic integrity</span>
            </li>
            <li>
              <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span>Self-hosted on AWS GovCloud, Google Cloud, or Azure VPC</span>
            </li>
            <li>
              <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span>Comprehensive audit logs with immutable signed ledger</span>
            </li>
          </ul>
        </div>
        <div class="panel-preview">
          <div class="interactive-card">
            <div class="card-bar">
              <span>Hardware Enclave Attestation</span>
              <span class="status-pill green">Enclave Verified</span>
            </div>
            <div class="enclave-spec">
              <div><strong>Cipher:</strong> ChaCha20-Poly1305</div>
              <div><strong>Attestation Hash:</strong> 8f92-ec20-41bf-a379</div>
              <div><strong>VPC Status:</strong> Fully Air-Gapped & Sealed</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .tabs-nav {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }

  .tab-btn {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1.4rem;
    border-radius: var(--radius-full);
    background: var(--bg-card);
    border: 1px solid var(--border-medium);
    color: var(--text-secondary);
    font-size: 0.92rem;
    font-weight: 600;
    transition: all var(--transition-fast);
  }

  .tab-btn:hover {
    color: var(--text-highlight);
    border-color: var(--brand-primary);
  }

  .tab-btn.active {
    background: var(--gradient-brand);
    color: #fff;
    border-color: transparent;
    box-shadow: 0 4px 15px rgba(99, 102, 241, 0.4);
  }

  .tabs-content {
    max-width: 1040px;
    margin: 0 auto;
  }

  .tab-panel {
    display: none;
    grid-template-columns: 1.2fr 1fr;
    gap: 3rem;
    padding: 3rem;
    align-items: center;
  }

  .tab-panel.active {
    display: grid;
  }

  @media (max-width: 860px) {
    .tab-panel {
      grid-template-columns: 1fr;
      padding: 2rem;
      gap: 2rem;
    }
  }

  .panel-badge {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--brand-accent);
    margin-bottom: 0.75rem;
  }

  .panel-heading {
    font-size: clamp(1.4rem, 2.2vw, 1.85rem);
    font-weight: 800;
    line-height: 1.25;
    color: var(--text-highlight);
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .panel-text {
    font-size: 0.98rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }

  .panel-features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .panel-features li {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.92rem;
    color: var(--text-primary);
  }

  .check-icon {
    width: 20px;
    height: 20px;
    color: var(--brand-emerald);
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* Interactive Previews */
  .interactive-card {
    background: #090d16;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    box-shadow: var(--shadow-lg);
  }

  .card-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.78rem;
    font-weight: 700;
    color: #94a3b8;
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .status-pill {
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-full);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .status-pill.green {
    background: rgba(16, 185, 129, 0.15);
    color: #10b981;
  }

  .status-pill.cyan {
    background: rgba(6, 182, 212, 0.15);
    color: #06b6d4;
  }

  .graph-nodes {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    align-items: flex-start;
    margin-bottom: 1.25rem;
  }

  .node-box {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: #f8fafc;
  }

  .main-node {
    border-color: var(--brand-primary);
    background: rgba(99, 102, 241, 0.15);
  }

  .node-arrow {
    color: var(--brand-accent);
    font-size: 0.85rem;
    padding-left: 0.5rem;
  }

  .code-box-preview {
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.75rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: #a5f3fc;
  }

  .deploy-stage {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .stage-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0.85rem;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.04);
    font-size: 0.84rem;
    color: #cbd5e1;
  }

  .stage-item.completed .stage-num {
    background: #10b981;
    color: #fff;
  }

  .stage-item.active {
    border: 1px solid var(--brand-accent);
    background: rgba(6, 182, 212, 0.1);
    color: #fff;
  }

  .stage-num {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .trace-row {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 0.4rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .trace-row.sub {
    padding-left: 1rem;
    color: #94a3b8;
  }

  .trace-suggestion {
    margin-top: 1rem;
    padding: 0.75rem;
    background: rgba(245, 158, 11, 0.1);
    border: 1px solid rgba(245, 158, 11, 0.2);
    border-radius: var(--radius-sm);
    font-size: 0.78rem;
    color: #fef3c7;
  }

  .enclave-spec {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.8;
    color: #e2e8f0;
  }
</style>

<script is:inline>
  const tabButtons = document.querySelectorAll('.tab-btn');
  const tabPanels = document.querySelectorAll('.tab-panel');

  tabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-tab');
      
      tabButtons.forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      tabPanels.forEach(p => p.classList.remove('active'));

      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');
      const targetPanel = document.getElementById(targetId);
      if (targetPanel) {
        targetPanel.classList.add('active');
      }
    });
  });
</script>

