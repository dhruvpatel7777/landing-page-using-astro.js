---
// Footer.astro
---

<footer class="site-footer">
  <div class="container footer-container">
    <!-- Top Row: Brand & Status -->
    <div class="footer-top">
      <div class="footer-brand">
        <a href="#" class="brand-logo" aria-label="PulseAI Home">
          <div class="logo-icon-wrap">
            <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect width="32" height="32" rx="8" fill="url(#footer-grad)" />
              <path d="M7 16H11L14 8L18 24L21 16H25" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              <defs>
                <linearGradient id="footer-grad" x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#6366F1"/>
                  <stop offset="0.5" stop-color="#8B5CF6"/>
                  <stop offset="1" stop-color="#06B6D4"/>
                </linearGradient>
              </defs>
            </svg>
          </div>
          <span class="brand-name">Pulse<span class="brand-accent">AI</span></span>
        </a>
        <p class="brand-tagline">
          The autonomous intelligence engine empowering engineering teams to build, optimize, and deploy at the speed of thought.
        </p>

        <!-- Live Uptime Status Badge -->
        <div class="status-badge">
          <span class="status-dot"></span>
          <span class="status-text">All Global Edge Clusters Operational (99.999%)</span>
        </div>
      </div>

      <!-- Links Grid -->
      <div class="footer-links-grid">
        <!-- Col 1 -->
        <div class="link-col">
          <h4 class="col-title">Product</h4>
          <ul class="col-links">
            <li><a href="#features">Autonomous AST Engine</a></li>
            <li><a href="#architecture">Sub-15ms Edge Runtimes</a></li>
            <li><a href="#features">Microsecond Traces</a></li>
            <li><a href="#calculator">ROI Calculator</a></li>
            <li><a href="#pricing">Pricing Plans</a></li>
            <li><a href="#features">Changelog <span class="tag-new">v3.4</span></a></li>
          </ul>
        </div>

        <!-- Col 2 -->
        <div class="link-col">
          <h4 class="col-title">Developers</h4>
          <ul class="col-links">
            <li><a href="#architecture">Documentation</a></li>
            <li><a href="#architecture">CLI Reference</a></li>
            <li><a href="#architecture">Astro.js Integration</a></li>
            <li><a href="#architecture">OpenTelemetry SDK</a></li>
            <li><a href="https://github.com" target="_blank" rel="noopener">GitHub Repository</a></li>
            <li><a href="#faq">System Status</a></li>
          </ul>
        </div>

        <!-- Col 3 -->
        <div class="link-col">
          <h4 class="col-title">Solutions</h4>
          <ul class="col-links">
            <li><a href="#features">Monorepo Optimization</a></li>
            <li><a href="#architecture">Zero-Trust Enterprise VPC</a></li>
            <li><a href="#testimonials">Startups & Scale-ups</a></li>
            <li><a href="#features">Continuous Security Audits</a></li>
            <li><a href="#pricing">SOC2 & HIPAA Compliance</a></li>
          </ul>
        </div>

        <!-- Col 4 -->
        <div class="link-col">
          <h4 class="col-title">Company</h4>
          <ul class="col-links">
            <li><a href="#testimonials">Customer Stories</a></li>
            <li><a href="#faq">Engineering Philosophy</a></li>
            <li><a href="#pricing">Careers <span class="tag-hiring">Hiring</span></a></li>
            <li><a href="#faq">Security Whitepaper</a></li>
            <li><a href="#faq">Privacy & Terms</a></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Bottom Row: Copyright & Socials -->
    <div class="footer-bottom">
      <div class="copyright-text">
        © 2026 PulseAI Systems, Inc. All rights reserved. Crafted with Astro.js.
      </div>

      <div class="social-links">
        <!-- X/Twitter -->
        <a href="https://twitter.com" target="_blank" rel="noopener" class="social-icon" aria-label="X / Twitter">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <!-- GitHub -->
        <a href="https://github.com" target="_blank" rel="noopener" class="social-icon" aria-label="GitHub">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.1-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2Z"/></svg>
        </a>
        <!-- Discord -->
        <a href="https://discord.com" target="_blank" rel="noopener" class="social-icon" aria-label="Discord">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.893.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
        </a>
        <!-- LinkedIn -->
        <a href="https://linkedin.com" target="_blank" rel="noopener" class="social-icon" aria-label="LinkedIn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border-subtle);
    background: var(--bg-secondary);
    padding-top: 5rem;
    padding-bottom: 3rem;
    margin-top: auto;
  }

  .footer-container {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.3fr 2fr;
    gap: 4rem;
  }

  @media (max-width: 900px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text-highlight);
  }

  .logo-icon-wrap {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.35);
  }

  .brand-accent {
    color: var(--brand-accent);
  }

  .brand-tagline {
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 340px;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-full);
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.25);
    font-size: 0.78rem;
    color: var(--brand-emerald);
    font-weight: 600;
    width: fit-content;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--brand-emerald);
  }

  .footer-links-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  @media (max-width: 680px) {
    .footer-links-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .col-title {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-highlight);
    margin-bottom: 1.25rem;
  }

  .col-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .col-links a {
    font-size: 0.88rem;
    color: var(--text-secondary);
    transition: color var(--transition-fast);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .col-links a:hover {
    color: var(--brand-primary);
  }

  .tag-new {
    font-size: 0.65rem;
    font-weight: 700;
    background: rgba(6, 182, 212, 0.15);
    color: var(--brand-accent);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
  }

  .tag-hiring {
    font-size: 0.65rem;
    font-weight: 700;
    background: rgba(16, 185, 129, 0.15);
    color: var(--brand-emerald);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 2rem;
    border-top: 1px solid var(--border-subtle);
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .copyright-text {
    font-size: 0.86rem;
    color: var(--text-muted);
  }

  .social-links {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--bg-tertiary);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    transition: all var(--transition-fast);
  }

  .social-icon:hover {
    color: var(--text-highlight);
    border-color: var(--brand-primary);
    transform: translateY(-2px);
  }
</style>

